# ---------------------------------------------------------------------------------------------
# Copy to `.env` next to docker-compose.yml and fill in the two STACKIT values:
#
#     cp examples/.env.example examples/.env
#
# `.env` is gitignored (see the repository root .gitignore); `.env.example` is the committed
# template and must never contain a real value. Docker Compose reads `.env` automatically for
# variable interpolation - `docker compose --env-file` is only needed for a differently named file.
# ---------------------------------------------------------------------------------------------

# --- STACKIT Object Storage credentials ------------------------------------------------------
#
# These are S3 access keys for a STACKIT Object Storage credentials group, NOT a STACKIT service
# account key. Create them with:
# https://docs.stackit.cloud/products/storage/object-storage/how-tos/create-and-delete-object-storage-credentials/
#
# The `SECRET_` prefix is not decoration: since Camunda 8.9 the connector runtime's environment
# secret provider prepends `SECRET_` to every lookup, so the BPMN reference
# `{{secrets.STACKIT_S3_ACCESS_KEY}}` resolves from the variable `SECRET_STACKIT_S3_ACCESS_KEY`.
# Rename the variable and the reference stops resolving. The prefix is configurable through
# CAMUNDA_CONNECTOR_SECRETPROVIDER_ENVIRONMENT_PREFIX - see bundle/README.md.
#
# These values reach only the connectors container. Do not add them to the orchestration
# container: the Orchestration Cluster has no business holding your object-store credentials.
SECRET_STACKIT_S3_ACCESS_KEY=
SECRET_STACKIT_S3_SECRET_ACCESS_KEY=

# --- Image versions --------------------------------------------------------------------------
#
# The Orchestration Cluster image tag is pinned in docker-compose.yml itself rather than here, so
# that Dependabot can keep it current: it cannot resolve tags written as variables. It stays on
# the 8.10 line, the Camunda minor this connector release is built against.

# Tag for the locally built STACKIT connectors image. `docker compose up --build` builds it from
# bundle/Dockerfile; there is no published image for this repository yet.
STACKIT_CONNECTORS_IMAGE=envite/stackit-connectors:dev

# --- Demo cluster credentials ------------------------------------------------------------------
#
# The Orchestration Cluster below runs with basic authentication and an unprotected API, which is
# what makes this a two-command quickstart. These are local development credentials for a cluster
# reachable only from your machine - never reuse this configuration anywhere else.
CAMUNDA_DEMO_USER=demo
CAMUNDA_DEMO_PASSWORD=demo
