        <di:waypoint x="400" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRunFinishedEvent_di" bpmnElement="Flow_ToRunFinishedEvent">
        <di:waypoint x="468" y="200" />
