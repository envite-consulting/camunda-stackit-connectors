# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.{xml,xsd,bpmn,dmn,form}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[{mvnw,mvnw.cmd}]
# Keep the Apache-provided wrapper scripts byte-identical to upstream
trim_trailing_whitespace = false
insert_final_newline = false
