<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the test output readable. The key flow logs one DEBUG line per token exchange, and the
  caching and concurrency tests deliberately perform a good number of them, so running at DEBUG
  buries an actual failure under hundreds of lines. Raise de.envite.camunda.stackit to DEBUG
  locally when you need to see what the provider is doing.

  WireMock is pinned at WARN separately: at INFO it prints every stub match and every unmatched
  request, which is the bulk of the noise.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="de.envite.camunda.stackit" level="INFO" />
  <logger name="com.github.tomakehurst.wiremock" level="WARN" />
  <logger name="wiremock" level="WARN" />
  <logger name="org.eclipse.jetty" level="WARN" />

  <root level="WARN">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
