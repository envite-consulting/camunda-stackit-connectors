<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.envite.camunda.stackit</groupId>
    <artifactId>stackit-connectors-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>stackit-connector-workflows</artifactId>
  <packaging>jar</packaging>

  <name>STACKIT Connectors for Camunda 8 :: Workflows</name>
  <description>Camunda 8 outbound connector for STACKIT Workflows (managed Apache Airflow): triggers
    DAG runs and reads their state, task instances, XCom values and logs through the Airflow REST
    API of a STACKIT Workflows instance.</description>

  <properties>
    <element.template.id>de.envite.connectors.stackit.workflows.v1</element.template.id>
    <element.template.file>stackit-workflows-outbound-connector.json</element.template.file>
    <connector.class>de.envite.camunda.stackit.workflows.StackitWorkflowsConnectorFunction</connector.class>
  </properties>

  <dependencies>
    <!--
      Only for the StackitTokenProvider contract: the session provider depends on that interface,
      so that the STACKIT key flow can become a second token source later without touching it.
      The auth module brings no third-party code; this connector talks HTTP through java.net.http
      and therefore adds nothing to the shaded jar beyond this repository's own classes.
    -->
    <dependency>
      <groupId>de.envite.camunda.stackit</groupId>
      <artifactId>stackit-connector-auth</artifactId>
    </dependency>

    <!-- The unit tests stub the identity provider and the Airflow instance. -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.camunda.connector</groupId>
        <artifactId>element-template-generator-maven-plugin</artifactId>
        <configuration>
          <connectors>
            <connector>
              <connectorClass>${connector.class}</connectorClass>
              <files>
                <file>
                  <!-- Must equal @ElementTemplate(id = ...) or the file name mapping is ignored. -->
                  <templateId>${element.template.id}</templateId>
                  <templateFileName>${element.template.file}</templateFileName>
                </file>
              </files>
              <generateHybridTemplates>true</generateHybridTemplates>
            </connector>
          </connectors>
        </configuration>
      </plugin>
      <!-- Produces the -with-dependencies jar users mount into camunda/connectors-bundle. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
