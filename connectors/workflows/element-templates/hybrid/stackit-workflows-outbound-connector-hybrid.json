    "condition" : {
      "property" : "operationType",
      "equals" : "triggerDagRun",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "triggerDagRunLogicalDate",
    "label" : "Logical date",
    "description" : "Optional ISO 8601 date-time with offset, for example 2026-11-26T00:00:00Z. Leave empty: Airflow 2 then uses the trigger time, Airflow 3 creates the run without a logical date.",
    "optional" : true,
    "feel" : "optional",
    "group" : "operation",
    "binding" : {
      "name" : "operation.logicalDate",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationType",
      "equals" : "triggerDagRun",
      "type" : "simple"
    },
    "type" : "String"
  }, {
