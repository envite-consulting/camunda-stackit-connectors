{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "Hybrid STACKIT Workflows Outbound Connector",
  "id" : "de.envite.connectors.stackit.workflows.v1-hybrid",
  "description" : "Triggers and inspects DAG runs on STACKIT Workflows (managed Apache Airflow 2.11 or 3.1). Requires on the instance: an OAuth2 identity provider, an API Audience configured in its settings (without it STACKIT disables the session endpoint), and a client in that identity provider with the Airflow role User. Not a STACKIT service account.",
  "keywords" : [ "STACKIT", "workflows", "airflow", "apache airflow", "dag", "trigger dag", "dag run", "xcom", "pipeline", "sovereign cloud" ],
  "documentationRef" : "https://github.com/envite-consulting/camunda-stackit-connectors/blob/main/connectors/workflows/README.md",
  "version" : 1,
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [ "bpmn:Task" ],
  "elementType" : {
    "value" : "bpmn:ServiceTask"
  },
  "engines" : {
    "camunda" : "^8.10"
  },
  "groups" : [ {
    "id" : "taskDefinitionType",
    "label" : "Task definition type"
  }, {
    "id" : "authentication",
    "label" : "Authentication"
  }, {
    "id" : "configuration",
    "label" : "Configuration"
  }, {
    "id" : "operation",
    "label" : "Operation"
  }, {
    "id" : "connector",
    "label" : "Connector"
  }, {
    "id" : "output",
    "label" : "Output mapping"
  }, {
    "id" : "error",
    "label" : "Error handling"
  }, {
    "id" : "retries",
    "label" : "Retries"
  } ],
  "properties" : [ {
    "id" : "taskDefinitionType",
    "value" : "de.envite:stackit-workflows:1",
    "group" : "taskDefinitionType",
    "binding" : {
      "property" : "type",
      "type" : "zeebe:taskDefinition"
    },
    "type" : "String"
  }, {
    "id" : "authentication.tokenUrl",
    "label" : "Token URL",
    "description" : "The token endpoint of the identity provider configured on the Workflows instance, for example https://keycloak.example.com/realms/airflow/protocol/openid-connect/token. Must use https.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.tokenUrl",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "authentication.clientId",
    "label" : "Client ID",
    "description" : "A client in that identity provider allowed to use the client_credentials grant, for example {{secrets.STACKIT_WORKFLOWS_CLIENT_ID}}. Not a STACKIT service account.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.clientId",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "authentication.clientSecret",
    "label" : "Client secret",
    "description" : "Store it as a Camunda secret and reference it, for example {{secrets.STACKIT_WORKFLOWS_CLIENT_SECRET}}.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.clientSecret",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "authentication.scope",
    "label" : "Scope",
    "description" : "Optional, space-separated. Entra ID needs the application ID URI of the API with /.default, for example api://my-airflow-api/.default.",
    "optional" : true,
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.scope",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "authentication.audience",
    "label" : "Audience",
    "description" : "Optional audience parameter for identity providers that take one (Okta, Auth0). The token's aud claim must match the API Audience configured on the instance, however the identity provider sets it.",
    "optional" : true,
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.audience",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "authentication.resource",
    "label" : "Resource",
    "description" : "Optional RFC 8707 resource parameter. Leave empty unless your identity provider requires it.",
    "optional" : true,
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.resource",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "authentication.clientAuthentication",
    "label" : "Client authentication",
    "description" : "How the client ID and secret are sent to the token endpoint. Use the method the client is configured for in the identity provider.",
    "optional" : false,
    "value" : "basic",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.clientAuthentication",
      "type" : "zeebe:input"
    },
    "type" : "Dropdown",
    "choices" : [ {
      "name" : "HTTP Basic (client_secret_basic)",
      "value" : "basic"
    }, {
      "name" : "In the request body (client_secret_post)",
      "value" : "post"
    } ]
  }, {
    "id" : "configuration.instanceUrl",
    "label" : "Instance URL",
    "description" : "The URL of the STACKIT Workflows instance, as shown in the STACKIT Portal (the Airflow UI URL). Without /api/v1 or /api/v2. Must use https.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "configuration",
    "binding" : {
      "name" : "configuration.instanceUrl",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "configuration.apiVersion",
    "label" : "Airflow API version",
    "description" : "v1 for Airflow 2.11 instances (workflows-2.3-airflow-2.11, /api/v1), v2 for Airflow 3.1 instances (workflows-3.0-airflow-3.1, /api/v2). The connector does not detect the version; a wrong value fails with NOT_FOUND.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true,
      "pattern" : {
        "value" : "^(\\s*[vV][12]\\s*|=.*|\\{\\{secrets\\.[A-Za-z0-9_.\\-]+}})$",
        "message" : "must be v1 (Airflow 2.11), v2 (Airflow 3.1), a FEEL expression or a secret reference"
      }
    },
    "feel" : "optional",
    "group" : "configuration",
    "binding" : {
      "name" : "configuration.apiVersion",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "operationType",
    "label" : "Operation",
    "description" : "The Airflow operation this task performs. Every operation returns immediately.",
    "value" : "triggerDagRun",
    "group" : "operation",
    "binding" : {
      "name" : "operationType",
      "type" : "zeebe:input"
    },
    "type" : "Dropdown",
    "choices" : [ {
      "name" : "Trigger DAG run",
      "value" : "triggerDagRun"
    }, {
      "name" : "Get DAG run",
      "value" : "getDagRun"
    }, {
      "name" : "List DAG runs",
      "value" : "listDagRuns"
    }, {
      "name" : "Get task instances",
      "value" : "getTaskInstances"
    }, {
      "name" : "Get XCom value",
      "value" : "getXcom"
    }, {
      "name" : "Get task logs",
      "value" : "getTaskLogs"
    } ]
  }, {
    "id" : "triggerDagRunDagId",
    "label" : "DAG ID",
    "description" : "The dag_id of the DAG to run.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "operation",
    "binding" : {
      "name" : "operation.dagId",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationType",
      "equals" : "triggerDagRun",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "triggerDagRunConf",
    "label" : "Configuration (conf)",
    "description" : "A FEEL context the DAG reads as dag_run.conf, for example ={orderId: orderId, delaySeconds: 20}. It is stored with the run in Airflow: do not put secrets into it.",
    "optional" : true,
    "feel" : "required",
    "group" : "operation",
    "binding" : {
      "name" : "operation.conf",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationType",
      "equals" : "triggerDagRun",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "triggerDagRunFailIfPaused",
    "label" : "Fail if DAG is paused",
    "description" : "Airflow accepts runs of a paused DAG but never executes them; the run would stay queued for ever. When checked, the connector checks the DAG first and fails with CONFLICT if it is paused.",
    "optional" : true,
    "value" : true,
    "feel" : "static",
    "group" : "operation",
    "binding" : {
      "name" : "operation.failIfPaused",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationType",
      "equals" : "triggerDagRun",
      "type" : "simple"
    },
    "type" : "Boolean"
  }, {
    "id" : "triggerDagRunDagRunId",
    "label" : "Run ID",
    "description" : "Optional. Leave empty to use camunda-<processInstanceKey>-<elementInstanceKey>, which makes retries idempotent. If you set it, keep it unique per run and stable across retries. Allowed: letters, digits and _ . ~ : + -",
    "optional" : true,
    "feel" : "optional",
    "group" : "operation",
    "binding" : {
      "name" : "operation.dagRunId",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationType",
      "equals" : "triggerDagRun",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "triggerDagRunNote",
    "label" : "Note",
    "description" : "Optional note shown on the run in the Airflow UI.",
    "optional" : true,
    "feel" : "optional",
    "group" : "operation",
    "binding" : {
      "name" : "operation.note",
      "type" : "zeebe:input"
