    "label" : "Run ID",
    "description" : "The dagRunId returned by Trigger DAG run.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "operation",
    "binding" : {
      "name" : "operation.dagRunId",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationType",
      "equals" : "getDagRun",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "listDagRunsDagId",
    "label" : "DAG ID",
    "description" : "The dag_id of the DAG.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
