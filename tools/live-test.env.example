# Configuration for the live tests against a real STACKIT project (tools/live-tests.sh).
#
#   mkdir -p .secrets && cp tools/live-test.env.example .secrets/live-test.env
#
# .secrets/ is gitignored and excluded from the Docker build context. Never put real values in
# this example file. See README.md, "Testing against real STACKIT", for how to create each value.

# --- Required: STACKIT Object Storage (S3 data plane) -------------------------------------------

# eu01 (Germany) or eu02 (Austria) - the region the bucket was created in.
STACKIT_IT_REGION=eu01

# An existing bucket. The tests only write below camunda-stackit-connectors-live-it/ and delete
# everything they wrote at the end of each run.
STACKIT_IT_S3_BUCKET=

# Access key ID and secret access key of an Object Storage credentials group in the same project.
STACKIT_IT_S3_ACCESS_KEY=
STACKIT_IT_S3_SECRET_ACCESS_KEY=

# --- Optional: service account key flow (auth module) -------------------------------------------
#
# Leave empty to skip the auth live tests. The key file is the JSON STACKIT offers for download
# when you create a service account key; a relative path is resolved from the repository root.
STACKIT_IT_PROJECT_ID=
STACKIT_IT_SERVICE_ACCOUNT_KEY_FILE=.secrets/stackit-service-account-key.json
